<%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main class="container mx-auto p-8 mt-6 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-8">
        Here are our registered homes:
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 overflow-hidden border border-gray-100 flex flex-col justify-between">
            <div>
              <img 
                src="<%= home.photoUrl %>" 
                alt="<%= home.houseName %>" 
                class="w-full h-48 object-cover"
              />
              <div class="p-5">
                <h3 class="text-xl font-bold text-gray-800 mb-2"><%= home.houseName %></h3>
                <p class="text-gray-600 mb-4 flex items-center">
                  <span class="mr-1">📍</span> <%= home.location %>
                </p>
              </div>
            </div>
            <div class="p-5 pt-0 flex justify-between items-center border-t border-gray-100 mt-auto">
              <div>
                <span class="text-xl font-bold text-red-500">$<%= home.price %></span>
                <span class="text-gray-500 text-sm"> / night</span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
